{
  "name": "solana-wallet-toolkit-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing Solana keypair, vanity address, signing and verification tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "solana-wallet-toolkit-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "solana",
    "mcp",
    "model-context-protocol",
    "wallet",
    "vanity",
    "keypair"
  ],
  "license": "SEE LICENSE IN ../LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/solana-wallet-toolkit"
  },
  "bugs": {
    "url": "https://github.com/nirholas/solana-wallet-toolkit/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
